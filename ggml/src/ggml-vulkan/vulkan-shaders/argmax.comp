#version 450

#include "generic_head.glsl"
#include "types.glsl"

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_ballot : enable

#define FLT_MAX 3.402823466e+38F

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_d[];};

layout (constant_id = 0) const uint BLOCK_SIZE = 32;

shared FLOAT_TYPE tmpmax[BLOCK_SIZE];
shared uint tmp[BLOCK_SIZE];

void main() {
    const uint row = gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x;
    const uint col = gl_LocalInvocationID.x;

    if (row >= p.KY) {
        return;
    }

    FLOAT_TYPE amax = FLOAT_TYPE(-FLT_MAX);
    uint acol = col;

    if (col < p.KX) {
        amax = FLOAT_TYPE(data_a[row*p.KX + col]);
    }

    for (uint i = col + BLOCK_SIZE; i < p.KX; i += BLOCK_SIZE) {
        FLOAT_TYPE val = FLOAT_TYPE(data_a[row*p.KX + i]);
        if (val > amax) {
            amax = val;
            acol = i;
        }
    }

    // Subgroup-accelerated argmax reduction (2 barriers vs log2(BLOCK_SIZE)+1)
    // Step 1: intra-subgroup reduction using subgroupMax + ballot
    FLOAT_TYPE sg_max = subgroupMax(amax);
    uvec4 ballot = subgroupBallot(amax == sg_max);
    uint winner = subgroupBallotFindLSB(ballot);
    acol = subgroupBroadcast(acol, winner);

    // Step 2: cross-subgroup reduction via shared memory
    if (subgroupElect()) {
        tmpmax[gl_SubgroupID] = sg_max;
        tmp[gl_SubgroupID] = acol;
    }
    barrier();

    if (gl_SubgroupID == 0u) {
        FLOAT_TYPE val = (gl_SubgroupInvocationID < gl_NumSubgroups)
            ? tmpmax[gl_SubgroupInvocationID] : FLOAT_TYPE(-FLT_MAX);
        uint idx = (gl_SubgroupInvocationID < gl_NumSubgroups)
            ? tmp[gl_SubgroupInvocationID] : 0u;

        FLOAT_TYPE max_val = subgroupMax(val);
        uvec4 ballot2 = subgroupBallot(val == max_val);
        uint winner2 = subgroupBallotFindLSB(ballot2);
        idx = subgroupBroadcast(idx, winner2);

        if (gl_SubgroupInvocationID == 0u) {
            tmp[0] = idx;
        }
    }
    barrier();

    if (col == 0) {
        data_d[row] = D_TYPE(tmp[0]);
    }
}
