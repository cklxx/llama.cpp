#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

#include "types.glsl"

layout (push_constant) uniform parameter
{
    uint32_t ne00;
    uint32_t ne01;
    uint32_t nb00;
    uint32_t nb01;
    uint32_t a_offset;
} p;

#define BLOCK_SIZE 256

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {uint data_a[];};
layout (binding = 1) writeonly buffer D {uint data_d[];};

// Only need one slot per subgroup instead of per thread
shared uint partial_sums[BLOCK_SIZE / 32];

void main() {
    const uint expert_id = gl_WorkGroupID.x;
    const uint num_elements = p.ne00 * p.ne01;
    const uint tid = gl_LocalInvocationID.x;

    uint count = 0;
    for (uint idx = tid; idx < num_elements; idx += BLOCK_SIZE) {
        const uint i01 = idx / p.ne00;
        const uint i00 = idx % p.ne00;
        const uint a = data_a[p.a_offset + i01 * p.nb01 + i00 * p.nb00];

        count += uint(a == expert_id);
    }

    // Phase 1: reduce within each subgroup using subgroup intrinsics (no barriers)
    count = subgroupAdd(count);

    // Phase 2: one thread per subgroup writes partial sum to shared memory
    if (subgroupElect()) {
        partial_sums[gl_SubgroupID] = count;
    }

    barrier();

    // Phase 3: first subgroup reduces across all subgroup partial sums
    const uint num_subgroups = BLOCK_SIZE / gl_SubgroupSize;
    if (gl_SubgroupID == 0) {
        count = (gl_SubgroupInvocationID < num_subgroups)
              ? partial_sums[gl_SubgroupInvocationID]
              : 0;
        count = subgroupAdd(count);
    }

    if (tid == 0) {
        data_d[expert_id] = count;
    }
}
