#version 450

#include "generic_head.glsl"
#include "types.glsl"

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#define BLOCK_SIZE 512

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer X {A_TYPE data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_d[];};

shared float tmp[BLOCK_SIZE];

void main() {
    const uint group_size = p.KX;
    const float eps = p.param1;

    const uint tid = gl_LocalInvocationID.x;
    const uint start = gl_WorkGroupID.x * group_size + tid;
    const uint end = (gl_WorkGroupID.x + 1) * group_size;

    float partial = 0.0f;

    // Calculate mean
    [[unroll]] for (uint col = start; col < end; col += BLOCK_SIZE) {
        partial += float(data_a[col]);
    }

    // Subgroup-accelerated reduction (2 barriers vs 10)
    partial = subgroupAdd(partial);
    if (subgroupElect()) {
        tmp[gl_SubgroupID] = partial;
    }
    barrier();
    if (gl_SubgroupID == 0) {
        float v = (gl_SubgroupInvocationID < gl_NumSubgroups) ? tmp[gl_SubgroupInvocationID] : 0.0f;
        v = subgroupAdd(v);
        tmp[0] = v;
    }
    barrier();

    const float mean = tmp[0] / group_size;

    partial = 0.0f;

    // Calculate variance
    [[unroll]] for (uint col = start; col < end; col += BLOCK_SIZE) {
        const float xi = float(data_a[col]) - mean;
        data_d[col] = D_TYPE(xi);
        partial += xi * xi;
    }

    // Subgroup-accelerated reduction (2 barriers vs 10)
    partial = subgroupAdd(partial);
    if (subgroupElect()) {
        tmp[gl_SubgroupID] = partial;
    }
    barrier();
    if (gl_SubgroupID == 0) {
        float v = (gl_SubgroupInvocationID < gl_NumSubgroups) ? tmp[gl_SubgroupInvocationID] : 0.0f;
        v = subgroupAdd(v);
        tmp[0] = v;
    }
    barrier();

    const float variance = tmp[0] / group_size;
    const float scale = inversesqrt(variance + eps);

    [[unroll]] for (uint col = start; col < end; col += BLOCK_SIZE) {
        data_d[col] *= D_TYPE(scale);
    }
}
